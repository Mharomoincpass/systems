# MongoDB Connection String
# Local: mongodb://localhost:27017/myapp
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/myapp
MONGODB_URI="mongodb://localhost:27017/myapp"

# JWT Secret (generate a random string for production)
JWT_SECRET="your-secret-key-change-this-in-production"

# Admin password for studio admin panel (A button)
STUDIO_ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# Node Environment
NODE_ENV="development"

# App URL
# Local dev uses HTTPS (npm run dev → next dev --experimental-https). Accept the self-signed cert in the browser once.
NEXT_PUBLIC_APP_URL="https://localhost:3000"

# Voice AI (browser mic → OpenAI → ElevenLabs speech)
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Hugging Face API Token for Image Generation
# Get one at: https://huggingface.co/settings/tokens
NEXT_PUBLIC_HF_TOKEN="your-huggingface-token-here"

# Pollinations.ai API Key for Video Generation
# Get one at: https://enter.pollinations.ai
# Note: Use SECRET key (sk_...) for server-side, not PUBLISHABLE key (pk_...)
POLLINATIONS_API_KEY="your-pollinations-secret-key-here"

# ZeptoMail API configuration for transactional email
# API key format is the encrypted Zoho key value only (without "Zoho-enczapikey " prefix)
ZEPTOMAIL_API_KEY="your-zeptomail-encrypted-api-key"
# Must match a verified sender/domain in ZeptoMail (ZEPTOMAIL_FROM_ADDRESS also works)
ZEPTOMAIL_FROM="noreply@yourdomain.com"
# India Zoho accounts use api.zeptomail.in (default). US/global: https://api.zeptomail.com/v1.1
# ZEPTOMAIL_API_BASE="https://api.zeptomail.in/v1.1"
# Optional logo in HTML emails (defaults to NEXT_PUBLIC_APP_URL/icon.svg)
# STUDIO_MAIL_LOGO_URL="https://mharomo.systems"

